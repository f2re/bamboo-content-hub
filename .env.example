APP_BASE_URL=http://localhost:8080
DATABASE_URL=sqlite:///./data/bamboo.db
DATA_DIR=./data
MEDIA_DIR=./data/media
SECRET_KEY=replace-with-long-random-value
MASTER_KEY=replace-with-separate-long-random-value
TRUSTED_LAN=true
SCHEDULER_ENABLED=true
SIGNED_MEDIA_TTL_SECONDS=1800
MAX_UPLOAD_BYTES=104857600
# OAuth application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# Provider endpoints may be overridden when their API changes
META_AUTHORIZE_URL=https://www.facebook.com/v23.0/dialog/oauth
META_TOKEN_URL=https://graph.facebook.com/v23.0/oauth/access_token
VK_AUTHORIZE_URL=https://id.vk.com/authorize
VK_TOKEN_URL=https://id.vk.com/oauth2/auth
WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SECRET=
